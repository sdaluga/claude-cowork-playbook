# Copy to .env and fill in, then load it yourself before running:
#   pip install python-dotenv
#   python -c "from dotenv import load_dotenv; load_dotenv()" && python agent.py "Acme"
#
# The Agent SDK reads the key from the process environment. It does NOT read
# .env files automatically.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Optional: route through a cloud provider instead of api.anthropic.com ---
# Amazon Bedrock
# CLAUDE_CODE_USE_BEDROCK=1
#
# Google Cloud's Agent Platform
# CLAUDE_CODE_USE_VERTEX=1
#
# Microsoft Foundry
# CLAUDE_CODE_USE_FOUNDRY=1
